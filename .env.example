# Runtime
NODE_ENV=development
PORT=4000
DOMAIN=faithhaven.example.com
APP_URL=https://faithhaven.example.com
ACME_EMAIL=operations@faithhaven.example.com
CORS_ORIGIN=https://faithhaven.example.com
TRUST_PROXY=true
COOKIE_SECURE=true
COOKIE_DOMAIN=

# PostgreSQL (development compose values only; replace every production value)
POSTGRES_DB=faithhaven
POSTGRES_USER=faithhaven
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://faithhaven:replace-with-a-long-random-password@postgres:5432/faithhaven
DATABASE_SSL=false

# Authentication (generate a 32+ byte random value; never use this example value)
JWT_SECRET=replace-with-a-cryptographically-random-32-byte-secret
JWT_ISSUER=faithhaven
JWT_AUDIENCE=faithhaven-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
CSRF_COOKIE_NAME=fh_csrf
REFRESH_COOKIE_NAME=fh_refresh
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX=20

# GenX gateway. The URL must be the approved GenX gateway endpoint, never a model-provider endpoint.
GENX_API_KEY=
GENX_API_URL=
GENX_MODEL=faithhaven-default
GENX_TIMEOUT_MS=30000

# Transactional email. SMTP URL follows nodemailer syntax, for example smtp://user:password@mail.example.com:587
SMTP_URL=
EMAIL_FROM=FaithHaven <no-reply@faithhaven.example.com>

# PayFast. Use the live endpoint only with live merchant credentials after ITN configuration is verified.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_ENDPOINT=https://sandbox.payfast.co.za/eng/process
PAYFAST_RETURN_URL=https://faithhaven.example.com/payment/success
PAYFAST_CANCEL_URL=https://faithhaven.example.com/payment/cancel
PAYFAST_NOTIFY_URL=https://faithhaven.example.com/api/payments/payfast/itn
PAYFAST_IP_WHITELIST=

# Licensed Bible audio / worship-media provider; leave blank to show the safe unavailable state.
MEDIA_PROVIDER_URL=
MEDIA_PROVIDER_KEY=
